---
import ExpedienteApp from '../components/ExpedienteApp';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Sistema multiagente para teoría del caso aumentada — Subida y procesamiento de expedientes judiciales en PDF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Teoría del Caso Aumentada — Ingesta de Expediente</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="relative z-0 bg-bg-primary h-screen overflow-hidden">
    <!-- React App Dashboard -->
    <ExpedienteApp client:load />
  </body>
</html>
